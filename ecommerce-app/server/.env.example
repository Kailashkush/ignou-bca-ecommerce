# ---------------------------------------------------------------------------
# Environment configuration template.
# Copy to ".env" and replace the placeholder values before running the server.
# The real ".env" file is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Community Server, default local instance)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Secret used to sign JSON Web Tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Origin allowed by the CORS policy (the React development server)
CLIENT_ORIGIN=http://localhost:5173

# Credentials created by "npm run seed" for the default administrator
SEED_ADMIN_EMAIL=admin@shopsphere.test
SEED_ADMIN_PASSWORD=Admin@12345

# IANA timezone used to bucket the dashboard sales figures by calendar day
STORE_TIMEZONE=Asia/Kolkata
