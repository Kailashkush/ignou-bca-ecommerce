# ---------------------------------------------------------------------------
# Client build configuration.
#
# Leave VITE_API_BASE_URL unset for local development: Vite proxies /api to the
# server on :5000, and a relative path is correct.
#
# Set it only when the client and the API are deployed to different origins,
# as they are on Render. It must be the API's origin with no trailing /api and
# no trailing slash.
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL=https://shopsphere-api.onrender.com
